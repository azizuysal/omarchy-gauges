#!/bin/bash

# Lets the network panel name every program using the network.
#
# Usage: sudo ./nethogs-setup            install nethogs
#        sudo ./nethogs-setup --remove   clean up after older versions
#
# The panel's list of programs comes from nethogs, which has to capture
# packets to see who is sending what. Arch's nethogs package gives the
# program the capabilities to do that without root, and gives them again on
# every update, so installing the package is all the setup there is. This
# installs it if it is missing, which is the same as:
#
#   sudo pacman -S nethogs
#
# Know what that grants: any user on this machine can then run nethogs and
# see which programs are talking on the network.
#
# This script does not change capabilities. Earlier versions of it did, and
# added pacman hooks and a note of their own; both ways of running it remove
# those leftovers, and nothing else. A hook file it did not write is never
# touched.
#
# Without nethogs the plugin still works; the list is then limited to the
# TCP connections of your own programs.

set -euo pipefail

# What nethogs needs, and what Arch's package gives it.
readonly capabilities="cap_net_admin,cap_net_raw,cap_dac_read_search,cap_sys_ptrace=ep"
readonly marker="# Installed by the Omarchy Gauges plugin's nethogs-setup."
# Everything an earlier version of this script could have left behind.
readonly old_hooks=(
  /etc/pacman.d/hooks/gauges-nethogs-capabilities.hook
  /etc/pacman.d/hooks/gauges-nethogs-capabilities-check.hook
)
readonly old_notes=/var/lib/gauges

if [[ $EUID -ne 0 ]]; then
  echo "This changes system files, so it needs root: sudo $0 $*" >&2
  exit 1
fi

# Removes the hooks earlier versions wrote (told apart by their first line)
# and their notes. The capabilities themselves are the package's, and stay.
clean_up() {
  local file
  for file in "${old_hooks[@]}"; do
    if [[ -f $file ]] && grep -qxF "$marker" "$file"; then
      rm "$file"
      echo "Removed $file, left by an earlier version of this script."
    elif [[ -e $file ]]; then
      echo "Left $file alone: this script did not write it."
    fi
  done
  rm -f "$old_notes"/nethogs-capabilities.{set,added,before}
  rmdir "$old_notes" 2>/dev/null || true
}

if [[ ${1:-} == --remove ]]; then
  clean_up
  echo "Nothing else of this script's is on the system."
  echo "nethogs itself is still installed; remove it with: pacman -Rns nethogs"
  exit 0
fi

clean_up

if ! command -v nethogs >/dev/null 2>&1; then
  if command -v pacman >/dev/null 2>&1; then
    pacman -S --needed --noconfirm nethogs
  else
    echo "nethogs is not installed, and there is no pacman to install it with." >&2
    echo "Install it with your system's package manager." >&2
    exit 1
  fi
fi

binary=$(realpath -e -- "$(command -v nethogs)")
if setcap -q -v "$capabilities" "$binary" >/dev/null 2>&1; then
  echo "Done: $(getcap -- "$binary")"
  echo "Open the network panel again to see every program."
else
  # Not Arch's package, or someone has changed them. Theirs to decide.
  echo "nethogs is installed, but does not have the capabilities the panel needs." >&2
  has=$(getcap -- "$binary" 2>&1 | sed "s|^$binary ||")
  echo "  it has:   ${has:-none}" >&2
  echo "  it needs: $capabilities" >&2
  echo "This script leaves them as they are. To grant them yourself:" >&2
  echo "  setcap $capabilities $binary" >&2
  echo "Until then the panel lists only your own programs' TCP connections." >&2
  exit 1
fi
