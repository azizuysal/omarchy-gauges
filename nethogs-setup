#!/bin/bash

# Lets the network panel name every program using the network.
#
# Usage: sudo ./nethogs-setup            set up
#        sudo ./nethogs-setup --remove   undo
#
# The panel's list of programs comes from nethogs, which has to capture
# packets to see who is sending what. This installs nethogs if it is missing,
# gives it the capabilities to do that without root, and adds a pacman hook
# that gives them back whenever nethogs is updated (an update replaces the
# file, and the capabilities with it).
#
# It manages only the capabilities it added itself, out of the four named
# below. It writes down which those are; it never sets, restores or removes
# any other capability, and never one of the four that nethogs already had.
# A hook file this script did not write is never overwritten or deleted.
#
# Know what you are granting: afterwards any user on this machine can run
# nethogs and see which programs are talking on the network. The hook grants
# the recorded capabilities again after every nethogs update, so to take one
# away for good, run --remove rather than clearing it by hand.
#
# Without this the plugin still works; the list is then limited to the TCP
# connections of your own programs.

set -euo pipefail

readonly wanted=(cap_net_admin cap_net_raw cap_dac_read_search cap_sys_ptrace)
readonly hook=/etc/pacman.d/hooks/gauges-nethogs-capabilities.hook
readonly marker="# Installed by the Omarchy Gauges plugin's nethogs-setup."
readonly state=/var/lib/gauges/nethogs-capabilities.added

if [[ $EUID -ne 0 ]]; then
  echo "This changes system files, so it needs root: sudo $0 $*" >&2
  exit 1
fi

# The capabilities a file has now, as text setcap accepts; empty for none.
current_capabilities() {
  local text
  text=$(getcap "$1")
  text=${text#"$1"}
  text=${text# }
  text=${text#= }
  printf '%s' "$text"
}

hook_is_ours() {
  [[ -f $hook ]] && grep -qxF "$marker" "$hook"
}

# The capabilities this script added on this machine, one per line. Anything
# in the record that is not one of the four is ignored.
added=()
read_added() {
  local name known
  added=()
  if [[ -f $state ]]; then
    while read -r name; do
      for known in "${wanted[@]}"; do
        [[ $name == "$known" ]] && added+=("$name")
      done
    done <"$state"
  elif hook_is_ours; then
    # A hook of ours without a record means Gauges 1.0.0 set this up. It
    # replaced whatever nethogs had with exactly these four, so all four are
    # this script's doing.
    added=("${wanted[@]}")
  fi
}

write_added() {
  install -d -m 755 "${state%/*}"
  printf '%s\n' "${added[@]}" >"$state"
}

joined() {
  local IFS=,
  printf '%s' "$*"
}

if [[ ${1:-} == --remove ]]; then
  # Undo only what this script can show it did: its record, or a hook it
  # wrote. With neither, nothing here is ours.
  if [[ ! -f $state ]] && ! hook_is_ours; then
    echo "Nothing to undo: nethogs-setup has not been run on this machine."
    exit 0
  fi

  read_added

  # Capabilities first, and any failure stops here: the record and the hook
  # are only removed once nethogs no longer has what this script gave it.
  binary=$(command -v nethogs || true)
  if [[ -n $binary && ${#added[@]} -gt 0 ]]; then
    now=$(current_capabilities "$binary")
    if [[ -n $now ]]; then
      # Take away the ones we added from what is there now; one that has
      # been cleared since is simply not there to take.
      setcap "$now $(joined "${added[@]}")-pe" "$binary"
      left=$(current_capabilities "$binary")
      if [[ -z $left || $left == "=" ]]; then
        setcap -r "$binary"
      fi
    fi
    left=$(current_capabilities "$binary")
    echo "nethogs' capabilities are now: ${left:-none}"
  fi

  if hook_is_ours; then
    rm "$hook"
    echo "Removed the pacman hook."
  elif [[ -e $hook ]]; then
    echo "Left $hook alone: this script did not write it."
  fi

  rm -f "$state"
  rmdir "${state%/*}" 2>/dev/null || true
  echo "nethogs itself is still installed; remove it with: pacman -Rns nethogs"
  exit 0
fi

# Check before changing anything, so a refusal leaves the system untouched.
if [[ -e $hook ]] && ! hook_is_ours; then
  echo "$hook already exists and was not written by this script." >&2
  echo "Move it out of the way, or merge it by hand, then run this again." >&2
  exit 1
fi

if ! command -v nethogs >/dev/null 2>&1; then
  if command -v pacman >/dev/null 2>&1; then
    pacman -S --needed --noconfirm nethogs
  else
    echo "nethogs is not installed, and there is no pacman to install it with." >&2
    exit 1
  fi
fi

binary=$(command -v nethogs)
read_added

# Grant the four one at a time, on top of what is there now. One that changes
# nothing was there already and stays out of the record; one that does is
# recorded at once, so the record never lags behind what was granted.
for name in "${wanted[@]}"; do
  before=$(current_capabilities "$binary")
  setcap "${before:+$before }$name+pe" "$binary"
  if [[ $(current_capabilities "$binary") != "$before" ]]; then
    known=false
    for have in ${added[@]+"${added[@]}"}; do
      [[ $have == "$name" ]] && known=true
    done
    [[ $known == true ]] || added+=("$name")
    write_added
  fi
done
[[ -f $state ]] || write_added

if command -v pacman >/dev/null 2>&1 && [[ ${#added[@]} -gt 0 ]]; then
  install -d /etc/pacman.d/hooks
  # The hook adds the recorded capabilities to whatever the updated nethogs
  # has at that moment; it carries no other capability.
  cat >"$hook" <<EOF
$marker
# An update replaces nethogs and drops its capabilities; this puts back the
# ones nethogs-setup added, on top of whatever nethogs has by then.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = nethogs

[Action]
Description = Restoring nethogs' capture capabilities for Gauges...
When = PostTransaction
Exec = /bin/sh -c 'c=\$(/usr/bin/getcap $binary); c=\${c#$binary}; exec /usr/bin/setcap "\$c $(joined "${added[@]}")+pe" $binary'
EOF
fi

echo "Done: $(getcap "$binary")"
echo "Open the network panel again to see every program."
